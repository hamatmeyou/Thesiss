generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String // Hashed
  role        String   @default("student") // admin, academic_admin, program_coordinator, instructor, counselor, student_assistant, student
  department  String?
  avatar      String?
  gpa         Float?
  major       String?
  year        Int?
  permissions String   @default("[]") // JSON string array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
